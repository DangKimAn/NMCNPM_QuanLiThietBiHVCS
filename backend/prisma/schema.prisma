// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS - Định nghĩa các trạng thái chuẩn
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}



enum EquipmentStatus {
  GOOD
  BROKEN
  UNDER_REPAIR
  DISCARDED
}

enum ReportStatus {
  PENDING
  PROCESSING
  RESOLVED
  REJECTED
}

// Enum dùng cho chức năng thông báo
// ALL: gửi cho tất cả role
// ADMIN: gửi cho quản trị viên
// MANAGER: gửi cho cán bộ quản lý thiết bị
// TEACHER: gửi cho giảng viên
// STUDENT: gửi cho sinh viên
enum NotificationTargetRole {
  ALL
  ADMIN
  MANAGER
  TEACHER
  STUDENT
}

// ==========================================
// MODELS
// ==========================================

model Role {
  roleId      Int              @id @default(autoincrement())
  roleName    String           @unique() @db.VarChar(255)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  permissionId   Int     @id @default(autoincrement())
  permissionName String  @unique()
  description    String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [roleId], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  userId               Int        @id @default(autoincrement())
  username             String     @unique @db.VarChar(255)
  fullName             String?    @db.VarChar(255)
  hashedPassword       String     @db.VarChar(255)
  email                String     @unique @db.VarChar(255)
  phoneNumber          String?    @db.VarChar(255)
  status               UserStatus @default(ACTIVE)
  roleId               Int
  refreshToken         String?
  resetPasswordCode    String?
  resetPasswordExpires DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  role               Role                @relation(fields: [roleId], references: [roleId], onDelete: Restrict)
  activityLogs       ActivityLog[]
  executedTransfers  EquipmentTransfer[] @relation("ExecutedTransfers")
  reports            Report[]            @relation("ReportedIncidents")
  handledResolutions Report[]            @relation("HandledResolutions")

  // Quan hệ thông báo
  sentNotifications     Notification[]     @relation("SentNotifications")
  receivedNotifications Notification[]     @relation("ReceivedNotifications")
  notificationReads     NotificationRead[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model ActivityLog {
  logId           Int      @id @default(autoincrement())
  userId          Int
  action          String   @db.VarChar(255)
  target          String   @db.VarChar(255)
  targetId        Int
  method          String?  @db.VarChar(10)
  route           String?  @db.VarChar(500)
  statusCode      Int?
  responseMessage String?  @db.Text
  content         String?  @db.Text
  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text
  isMarked        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}



model EquipmentCategory {
  categoryId  Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipments Equipment[]

  @@map("equipment_categories")
}

model Equipment {
  equipmentId   Int             @id @default(autoincrement())

  // Mã riêng của từng thiết bị thật ngoài đời
  // Ví dụ: TB000001, MC-A101-01, HDMI-A102-01
  equipmentCode String?         @unique @db.VarChar(255)

  name          String          @db.VarChar(255)
  categoryId    Int
  unit          String?         @db.VarChar(255)

  // Đã xóa trường quantity vì mỗi bản ghi đại diện cho 1 thiết bị thực tế

  status        EquipmentStatus @default(GOOD)
  description   String?         @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    EquipmentCategory     @relation(fields: [categoryId], references: [categoryId], onDelete: Restrict)
  allocations EquipmentAllocation[]
  transfers   EquipmentTransfer[]
  reports     Report[]

  @@index([categoryId])
  @@index([status])
  @@map("equipments")
}

model EquipmentAllocation {
  allocationId Int       @id @default(autoincrement())
  equipmentId  Int
  roomId       Int
  allocatedAt  DateTime? @db.Date
  note         String?   @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: Restrict)

  @@index([equipmentId])
  @@index([roomId])
  @@map("equipment_allocations")
}

model EquipmentTransfer {
  transferId    Int      @id @default(autoincrement())
  equipmentId   Int
  fromRoomId    Int
  toRoomId      Int
  transferredAt DateTime @db.Date
  executorId    Int
  note          String?  @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [equipmentId], onDelete: Restrict)
  executor  User      @relation("ExecutedTransfers", fields: [executorId], references: [userId], onDelete: Restrict)

  @@index([equipmentId])
  @@index([fromRoomId])
  @@index([toRoomId])
  @@index([executorId])
  @@map("equipment_transfers")
}

model Report {
  reportId      Int          @id @default(autoincrement())
  reporterId    Int
  roomId        Int
  equipmentId   Int?
  reportContent String       @db.Text
  status        ReportStatus @default(PENDING)
  reportedAt    DateTime     @default(now())

  // Phần gộp Resolution
  handlerId         Int?
  resolutionContent String?   @db.Text
  resolvedAt        DateTime?
  result            String?   @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter  User       @relation("ReportedIncidents", fields: [reporterId], references: [userId], onDelete: Restrict)
  handler   User?      @relation("HandledResolutions", fields: [handlerId], references: [userId], onDelete: Restrict)
  equipment Equipment? @relation(fields: [equipmentId], references: [equipmentId], onDelete: Restrict)

  @@index([reporterId])
  @@index([handlerId])
  @@index([roomId])
  @@index([equipmentId])
  @@index([status])
  @@map("reports")
}

// ==========================================
// FORM_CONFIG - Cấu hình form động cho Admin
// ==========================================

model FormConfig {
  formConfigId Int      @id @default(autoincrement())
  formKey      String   @db.VarChar(100)
  fieldKey     String   @db.VarChar(100)
  label        String   @db.VarChar(255)
  fieldType    String   @db.VarChar(50)
  required     Boolean  @default(false)
  visible      Boolean  @default(true)
  sortOrder    Int      @default(0)
  options      String?  @db.Text
  placeholder  String?  @db.VarChar(255)
  updatedAt    DateTime @updatedAt

  @@unique([formKey, fieldKey])
  @@map("form_configs")
}

// ==========================================
// NOTIFICATIONS - Chức năng thông báo
// ==========================================

model Notification {
  notificationId Int    @id @default(autoincrement())
  title          String @db.VarChar(255)
  content        String @db.Text

  // Vai trò nhận thông báo
  // ALL: tất cả người dùng đều xem được
  // ADMIN, MANAGER, TEACHER, STUDENT: chỉ role tương ứng xem được
  targetRole NotificationTargetRole @default(ALL)

  // Người tạo thông báo
  // Theo yêu cầu hiện tại: chỉ MANAGER được viết thông báo
  senderId Int
  sender   User @relation("SentNotifications", fields: [senderId], references: [userId], onDelete: Restrict)

  // Người nhận thông báo đích danh (nếu có)
  targetUserId Int?
  targetUser   User? @relation("ReceivedNotifications", fields: [targetUserId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads NotificationRead[]

  @@index([senderId])
  @@index([targetRole])
  @@index([targetUserId])
  @@map("notifications")
}

model NotificationRead {
  notificationId Int
  userId         Int
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("notification_reads")
}