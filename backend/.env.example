# =============================================
# BACKEND - Biến môi trường (.env.example)
# =============================================
# Sao chép file này thành .env và điền giá trị thật

# ----------------------------
# DATABASE (Supabase)
# ----------------------------
# Dùng connection pooling (cho runtime app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Dùng direct connection (cho prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?statement_timeout=300000"

# ----------------------------
# GOOGLE SSO
# ----------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Dev: http://localhost:3000/api/auth/google/callback
# Production: https://<your-render-app>.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ----------------------------
# JWT
# ----------------------------
JWT_ACCESS_SECRET="your-strong-access-secret-key"
JWT_REFRESH_SECRET="your-strong-refresh-secret-key"

# ----------------------------
# CORS - Frontend được phép gọi API
# ----------------------------
# Dev: http://localhost:5173
# Production: https://<your-vercel-app>.vercel.app
# Nhiều domain: dùng dấu phẩy, vd: https://app.vercel.app,https://custom-domain.com
FRONTEND_URL=http://localhost:5173

# ----------------------------
# EMAIL (SMTP - Gmail)
# ----------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="your-email@gmail.com"

# ----------------------------
# KHÁC
# ----------------------------
ROOM_API=https://mini-project-room.onrender.com
